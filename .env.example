# ============================================================
# NetPulse - Variables de entorno
# Copia este archivo a .env y completa los valores
# cp .env.example .env
# ============================================================

# --- Base de datos ---
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=netpulse
DATABASE_URL=postgresql://user:changeme@db:5432/netpulse

# --- Scanner ---
SCANNER_PORT=8000
BACKEND_URL=http://localhost:3001
DEBUG=False

# --- Frontend ---
VITE_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
